{
  "name": "kakeibo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "レシート画像をClaude APIで読み取る家計簿Webアプリ",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "chart.js": "^4.5.1",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.0"
  }
}
